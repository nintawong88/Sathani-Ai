---
import Layout from '../../layouts/Layout.astro';

const LINES = [
	{ n: 'Sprouts', who: '7–12, with an adult', c: 'var(--amber)', href: '/find-your-line' },
	{ n: 'Explorers', who: '13–17, at school', c: 'var(--rose)', href: '/find-your-line' },
	{ n: 'Builders', who: '18–24, heading for a job', c: 'var(--violet)', href: '/find-your-line' },
	{ n: 'Operators', who: 'Working professionals', c: 'var(--teal)', href: '/lines/operators' },
	{ n: 'Adaptive Pace', who: 'Your own schedule', c: 'var(--forest)', href: '/find-your-line' },
	{ n: 'Second Act', who: '60+, retired or winding down', c: 'var(--copper)', href: '/lines/second-act' },
];
---

<Layout title="Sathani AI" lang="en">
	<div class="flex min-h-screen flex-col">
		<header class="shrink-0 border-b" style="border-color:var(--rule)">
			<div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-2.5">
				<span class="eyebrow font-semibold" style="color:var(--ink)">Sathani AI</span>
				<a href="/" class="eyebrow underline decoration-2 underline-offset-4">ไทย</a>
			</div>
		</header>

		<main class="mx-auto flex w-full max-w-5xl flex-1 flex-col justify-center px-6 py-3">
			<section>
				<p class="eyebrow">No account · no email · three taps to start</p>
				<h1 class="font-display mt-2 text-xl leading-tight font-bold md:text-3xl">
					The gap between what Thais believe they're capable of.
				</h1>
				<p class="mt-2 max-w-xl text-sm md:text-base" style="color:var(--ink-soft)">
					Find the AI learning line that fits your life — fun, hands-on, no jargon.
				</p>
				<a
					href="/find-your-line"
					class="font-display mt-4 inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5 hover:shadow-lg md:text-base"
					style="background:var(--ink)"
				>
					Find your line →
				</a>
			</section>

			<section class="mt-5">
				<h2 class="eyebrow mb-2">6 lines</h2>
				<div class="grid grid-cols-2 gap-2 md:grid-cols-3">
					{
						LINES.map((l) => (
							<a
								href={l.href}
								class="group block rounded-lg border-2 p-3 transition-all hover:-translate-y-1 hover:shadow-xl"
								style={`border-color:${l.c}; background:var(--card)`}
							>
								<span
									class="inline-block h-2 w-2 rounded-full transition-transform group-hover:scale-150"
									style={`background:${l.c}`}
								/>
								<h3 class="font-display mt-1 text-base font-bold md:text-lg" style={`color:${l.c}`}>
									{l.n}
								</h3>
								<p class="mt-0.5 text-xs" style="color:var(--ink-soft)">
									{l.who}
								</p>
							</a>
						))
					}
				</div>
			</section>
		</main>
	</div>
</Layout>
