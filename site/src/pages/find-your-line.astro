let lang="th",A={},L={},litDone=false,skipped=false,line=null,station=1,prof={},cur="s1";
const $=id=>document.getElementById(id), t=()=>D[lang], steps=["s1","s2","s2b","s3","s4","s5"];

function show(id){cur=id;steps.forEach(s=>$(s).classList.toggle("on",s===id));window.scrollTo({top:0,behavior:"smooth"});paint()}
function paint(){
  const T=t();
  document.querySelectorAll("[data-t]").forEach(e=>{const v=T[e.dataset.t];if(typeof v==="string")e.textContent=v});
  $("brand").textContent=T.brand;$("contrast").textContent=T.contrast;$("reset").textContent=T.reset;
  const map={s1:0,s2:1,s2b:1,s3:2,s4:2,s5:3};
  $("rail").innerHTML=T.rail.map((n,i)=>`<div class="${i<map[cur]?'done':i===map[cur]?'now':''}"><b>${n[0]}</b><span>${n[1]}</span></div>`).join("");
  $("neverList").innerHTML=T.never.map(n=>`<li>${n}</li>`).join("");
  drawEntry();
  if(cur==="s2")drawLit();
  if(cur==="s2b")drawFac();
  if(line&&(cur==="s3"||cur==="s5"))decide();
  if(cur==="s4")drawProfile();
  if(cur==="s5")render5();
  drawLedger();
}
function drawEntry(){
  const T=t();
  $("entryQs").innerHTML=ENTRY.map(q=>{const d=q[lang];return `<div class="q"><p>${d.q}</p>${d.hint?`<p class="hint">${d.hint}</p>`:""}
    <div class="opts">${d.o.map(o=>`<button data-k="${q.k}" data-v="${o[1]}" aria-pressed="${A[q.k]===o[1]}">${o[0]}</button>`).join("")}</div></div>`}).join("");
  $("entryQs").querySelectorAll("button").forEach(b=>b.onclick=()=>{A[b.dataset.k]=b.dataset.v;drawEntry();drawLedger()});
  $("toS2").disabled=!ENTRY.every(q=>A[q.k]);
  const f=$("pathFlag");
  if(!A.age){f.style.display="none";return}
  f.style.display="block";
  if(A.age==="u13"||A.age==="t"){f.className="flag lock";f.innerHTML=`<b>${T.flagU18T}</b><span>${T.flagU18S}</span>`}
  else if(A.age==="y"){f.className="flag lock";f.innerHTML=`<b>${T.flag20T}</b><span>${T.flag20S}</span>`}
  else{f.className="flag";f.innerHTML=`<b>${T.flagFullT}</b><span>${T.flagFullS}</span>`}
}
function drawFac(){
  const T=t();
  $("facForm").innerHTML=`
  <fieldset><legend>${T.facLeg1}</legend>
    <label class="f">${T.facName}</label><input type="text">
    <label class="f">${T.facMail}</label><input type="text">
    <label class="f">${T.facRole}</label><select>${T.facRoles.map(r=>`<option>${r}</option>`).join("")}</select>
  </fieldset>
  <fieldset disabled><legend>${T.facLeg2}</legend>
    <label class="f">${T.lName}</label><input type="text" placeholder="${T.notColl}">
    <label class="f">${T.lSchool}</label><input type="text" placeholder="${T.notColl}">
    <label class="f">${T.lDob}</label><input type="text" placeholder="${T.dobNote}">
  </fieldset>`;
}
function drawLit(){
  $("litQs").innerHTML=LIT.map((q,i)=>{const d=q[lang];return `<div class="q"><p>${i+1}. ${d.q}</p>
    <div class="opts stack">${d.o.map((o,j)=>`<button data-i="${i}" data-j="${j}" aria-pressed="${L[i]===j}">${o}</button>`).join("")}</div></div>`}).join("");
  $("litQs").querySelectorAll("button").forEach(b=>b.onclick=()=>{L[b.dataset.i]=+b.dataset.j;drawLit();drawLedger()});
  $("toS3").disabled=Object.keys(L).length<LIT.length;
}
function litResult(){
  const T=t(),c={mechanics:0,verify:0,instruct:0,judge:0};
  LIT.forEach((q,i)=>{if(L[i]===q.a)c[q.c]++});
  const total=Object.values(c).reduce((a,b)=>a+b,0);
  if(c.judge===0)return{st:1,why:T.whyJudge};
  if(total>=6&&Object.values(c).every(v=>v>=1))return{st:3,why:T.whyStrong};
  if(total>=4)return{st:2,why:T.whyMid};
  return{st:1,why:T.whyLow};
}
function labelOf(k){const q=ENTRY.find(x=>x.k===k)[lang];return (q.o.find(o=>o[1]===A[k])||["—"])[0]}
function decide(){
  const T=t(),s={};
  ["age","goal"].forEach(k=>Object.entries(SCORE[k][A[k]]||{}).forEach(([id,n])=>s[id]=(s[id]||0)+n));
  line=Object.entries(s).sort((a,b)=>b[1]-a[1])[0][0];
  const r=(litDone&&!skipped)?litResult():{st:1,why:T.whySkip};
  station=r.st;
  const l=LINES[line],d=l[lang],tr=TRACKS[line]?TRACKS[line][lang]:null;
  const lock=(l.safeSt&&station>l.safeSt)?`<span class="locked">${T.lockNote(l.safeSt,d.safeName)}</span>`:"";
  const jobs=(A.age==="w"||A.age==="r");
  $("rec").innerHTML=`<div class="reccard" style="color:${l.c}">
    <div class="eyebrow" style="color:${l.c}">${T.yourLine}</div>
    <span class="lineName">${d.n}</span>
    <dl class="rows">
      <div class="row"><dt>${T.rLine}</dt><dd><b>${d.n} — ${d.who}</b><span>${d.dose}</span>
        <span class="why">${T.because(labelOf("age"),labelOf("goal"))}</span></dd></div>
      <div class="row"><dt>${T.rStation}</dt><dd><b>${T.stationOf(station)}</b><span class="why">${r.why}</span>${lock}</dd></div>
      <div class="row"><dt>${T.rTrack}</dt><dd><b>${tr?tr[0]:"—"}</b><span class="why">${tr?T.trackProv:T.noTrack}</span></dd></div>
      <div class="row"><dt>${T.rNext}</dt><dd>
        <b>${T.ns1(A.locale==="th"?T.langTH:T.langEN)}</b><span>${T.ns1s}</span>
        <b style="margin-top:8px">${T.ns2}</b><span>${T.ns2s}</span>
        <b style="margin-top:8px">${jobs?T.ns3o:T.ns3c}</b><span>${jobs?T.ns3os:T.ns3cs}</span>
      </dd></div>
    </dl></div>`;
}
function drawProfile(){
  const T=t(),full=(A.age==="w"||A.age==="r"),tr=TRACKS[line]?TRACKS[line][lang]:["—"];
  $("profileForm").innerHTML=`
  <fieldset><legend>${T.pLeg1}</legend>
    <label class="f">${T.pRole}</label><input type="text" id="p_role" placeholder="${T.pRoleP}" value="${prof.p_role||""}">
    <label class="f">${T.pInd}</label><select id="p_ind">${T.inds.map(i=>`<option ${prof.p_ind===i?"selected":""}>${i}</option>`).join("")}</select>
    <label class="f">${T.pTrack}</label><select id="p_track">${tr.map(x=>`<option>${x}</option>`).join("")}</select>
  </fieldset>
  <fieldset><legend>${T.pLeg2}</legend>
    <label class="f">${T.pEdu}</label><select id="p_edu">${T.edus.map(e=>`<option ${prof.p_edu===e?"selected":""}>${e}</option>`).join("")}</select>
  </fieldset>
  <fieldset ${full?"":"disabled"}><legend>${full?T.pLeg3:T.pLeg3l}</legend>
    <label class="f">${T.pOrg}</label><input type="text" id="p_org" placeholder="${full?T.pOrgP:T.locked21}">
    <label class="f">${T.pCv}</label><input type="text" id="p_cv" placeholder="${full?T.pCvP:T.locked21}">
  </fieldset>
  <fieldset><legend>${T.pLeg4}</legend>
    <label class="f">${T.pGen}</label><input type="text" id="p_gen" placeholder="${T.pGenP}" value="${prof.p_gen||""}">
  </fieldset>`;
  ["p_role","p_ind","p_edu","p_track","p_org","p_gen"].forEach(id=>{const e=$(id);if(e)e.oninput=e.onchange=()=>{prof[id]=e.value;drawLedger()}});
}
function render5(){
  const T=t(),l=LINES[line],d=l[lang];
  $("final").innerHTML=`<div class="reccard" style="color:${l.c}">
    <span class="lineName">${d.n} · ${T.stationOf(station)}</span>
    <p class="note">${T.spine} — ${d.dose}</p><p class="note">${T.changeAny}</p></div>`;
}
function drawLedger(){
  const T=t(),rows=[];
  if(A.locale)rows.push(["locale",labelOf("locale"),T.tagDev]);
  if(A.age)rows.push(["age_band",labelOf("age"),T.tagDev]);
  if(A.goal)rows.push(["goal",labelOf("goal"),T.tagDev]);
  if(A.age==="u13"||A.age==="t")rows.push(["facilitator_id","—",T.tagSrv]);
  const n=Object.keys(L).length;if(n)rows.push(["placement",T.answered(n),T.tagDev]);
  if(line){rows.push(["line",LINES[line][lang].n,T.tagDev]);rows.push(["station",station,T.tagDev])}
  Object.entries(prof).forEach(([k,v])=>{if(v&&v!=="—")rows.push([k.replace("p_","profile_"),v.length>16?v.slice(0,16)+"…":v,T.tagSrv])});
  $("ledger").innerHTML=rows.length?rows.map(r=>`<div class="rec"><i>${r[0]}</i><b>${r[1]}<br><span class="tag">${r[2]}</span></b></div>`).join("")
    :`<p class="note" style="margin:0">${T.ledEmpty}</p>`;
}

$("toS2").onclick=()=>{(A.age==="u13"||A.age==="t")?show("s2b"):show("s2")};
$("skipLit").onclick=()=>{skipped=true;litDone=false;decide();show("s3")};
$("toS3").onclick=()=>{litDone=true;skipped=false;decide();show("s3")};
$("toS3b").onclick=()=>{decide();show("s3")};
$("override").onclick=()=>show("s1");
$("toS4").onclick=()=>show("s4");
$("skipProf").onclick=()=>{prof={};show("s5")};
$("finish").onclick=()=>show("s5");
document.querySelectorAll("[data-scale]").forEach(b=>b.onclick=()=>{
  document.querySelectorAll("[data-scale]").forEach(x=>x.setAttribute("aria-pressed",x===b));
  document.documentElement.style.setProperty("--scale",b.dataset.scale)});
document.querySelectorAll("[data-lang]").forEach(b=>b.onclick=()=>{
  document.querySelectorAll("[data-lang]").forEach(x=>x.setAttribute("aria-pressed",x===b));
  lang=b.dataset.lang;document.documentElement.lang=lang;paint()});
$("contrast").onclick=e=>{const on=document.documentElement.dataset.contrast!=="high";
  document.documentElement.dataset.contrast=on?"high":"normal";e.target.setAttribute("aria-pressed",on)};
$("reset").onclick=()=>{A={};L={};prof={};litDone=skipped=false;line=null;station=1;show("s1")};

{
  const qp = new URLSearchParams(location.search).get("lang");
  if (qp === "en") {
    lang = "en";
    document.documentElement.lang = "en";
    document.querySelectorAll("[data-lang]").forEach(b=>b.setAttribute("aria-pressed", String(b.dataset.lang==="en")));
  }
}
paint();
</script>
</body>
</html>
