<!DOCTYPE html>
<html lang="th" data-contrast="normal">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AI Lines — ขั้นตอนเข้าใช้งาน จัดระดับ และโปรไฟล์</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=IBM+Plex+Sans+Thai:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style is:global>
:root{
  --paper:#EBEDF1;--card:#F7F8FA;--ink:#12161D;--ink-soft:#4E5765;--rule:#C7CDD6;
  --amber:#B4761C;--rose:#C42A62;--violet:#5B3FC9;--teal:#0C6D7C;--forest:#237848;--copper:#96471E;
  --lock:#8A2F2F;--scale:1;
  font-size:calc(16px * var(--scale));
}
html[data-contrast="high"]{--paper:#fff;--card:#fff;--ink:#000;--ink-soft:#1D2229;--rule:#7C838D;
  --amber:#7A4E08;--rose:#96003F;--violet:#3B1FA8;--teal:#004C59;--forest:#0C5730;--copper:#6E2E09}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font-family:"IBM Plex Sans Thai",system-ui,sans-serif;line-height:1.62}
h1,h2,h3{font-family:"Bricolage Grotesque",system-ui,sans-serif;font-weight:800;letter-spacing:-.02em;line-height:1.12;margin:0}
html[lang="th"] h1,html[lang="th"] h2,html[lang="th"] h3{font-family:"IBM Plex Sans Thai",sans-serif;font-weight:600;letter-spacing:0;line-height:1.3}
button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px}
.eyebrow{font-family:"IBM Plex Mono",monospace;font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft)}
html[lang="th"] .eyebrow{font-family:"IBM Plex Sans Thai";letter-spacing:.04em;text-transform:none;font-size:.8rem}

.util{position:sticky;top:0;z-index:60;background:var(--ink);color:var(--paper)}
.util .wrap{display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:8px 20px}
.util .brand{font-weight:600;margin-right:auto;font-size:.98rem}
.util button{background:transparent;border:1px solid rgba(255,255,255,.3);color:inherit;border-radius:99px;padding:3px 11px;font-size:.8rem}
.util button[aria-pressed="true"]{background:var(--paper);color:var(--ink)}
.util :focus-visible{outline-color:#fff}

.rail{display:flex;margin:34px 0 10px;flex-wrap:wrap}
.rail div{flex:1 1 130px;border-top:5px solid var(--rule);padding:8px 12px 0 0}
.rail div.done{border-color:var(--ink)}
.rail div.now{border-color:var(--teal)}
.rail b{display:block;font-size:.98rem;font-weight:600}
.rail span{font-size:.78rem;color:var(--ink-soft)}

.layout{display:grid;grid-template-columns:1fr 340px;gap:34px;align-items:start;padding-bottom:70px}
.stage{background:var(--card);border:1px solid var(--rule);border-radius:4px;padding:26px}
.step{display:none}.step.on{display:block}
h2.big{font-size:clamp(1.5rem,4vw,2.2rem);margin-bottom:6px}
.q{margin-top:22px;border-top:1px dashed var(--rule);padding-top:16px}
.q:first-of-type{border-top:0}
.q p{font-weight:600;font-size:1.05rem;margin:0 0 10px}
.q .hint{font-weight:400;font-size:.86rem;color:var(--ink-soft);margin:-6px 0 10px}
.opts{display:flex;flex-wrap:wrap;gap:8px}
.opts button{background:var(--paper);border:1px solid var(--rule);border-radius:99px;padding:7px 15px;font-size:.92rem;text-align:left}
.opts button[aria-pressed="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.opts.stack{flex-direction:column;align-items:stretch}
.opts.stack button{border-radius:4px}
.act{margin-top:26px;display:flex;gap:10px;flex-wrap:wrap}
.primary{background:var(--ink);color:var(--paper);border:0;border-radius:99px;padding:10px 22px}
.primary[disabled]{opacity:.35;cursor:not-allowed}
.ghost{background:transparent;border:1px solid var(--rule);border-radius:99px;padding:10px 18px}
.note{font-size:.9rem;color:var(--ink-soft);margin-top:12px}

.flag{border-left:5px solid var(--teal);background:var(--paper);padding:14px 16px;margin-top:20px;border-radius:0 4px 4px 0}
.flag.lock{border-color:var(--lock)}
.flag b{display:block;font-weight:600;font-size:1rem}
.flag span{font-size:.9rem;color:var(--ink-soft)}

.reccard{border:2px solid currentColor;border-radius:4px;padding:22px;margin-top:8px}
.lineName{font-weight:600;font-size:1.9rem;display:block;color:var(--ink);line-height:1.25}
.rows{margin-top:18px;border-top:1px solid var(--rule)}
.row{display:grid;grid-template-columns:130px 1fr;gap:14px;padding:12px 0;border-bottom:1px solid var(--rule)}
.row dt{font-size:.78rem;color:var(--ink-soft);padding-top:4px}
.row dd{margin:0}
.row dd b{display:block;color:var(--ink)}
.row dd span{display:block;font-size:.88rem;color:var(--ink-soft)}
.why{font-size:.85rem;color:var(--ink-soft)}
.locked{color:var(--lock);font-size:.76rem;border:1px solid var(--lock);border-radius:99px;padding:1px 10px;display:inline-block;margin-top:5px}

.ledger{position:sticky;top:64px;border:1px solid var(--ink);border-radius:4px;background:var(--card)}
.ledger header{background:var(--ink);color:var(--paper);padding:12px 16px}
.ledger header b{font-size:1rem;display:block;font-weight:600}
.ledger header span{font-size:.78rem;opacity:.72}
.ledger .body{padding:14px 16px}
.rec{font-size:.82rem;border-bottom:1px dashed var(--rule);padding:7px 0;display:flex;justify-content:space-between;gap:10px}
.rec i{font-style:normal;color:var(--ink-soft);font-family:"IBM Plex Mono",monospace;font-size:.74rem}
.rec b{font-weight:500;text-align:right}
.tag{display:inline-block;font-size:.66rem;border:1px solid var(--rule);border-radius:99px;padding:0 8px;color:var(--ink-soft)}
.never{margin-top:14px;padding-top:12px;border-top:2px solid var(--ink)}
.never b{font-weight:600;font-size:.95rem}
.never ul{margin:6px 0 0;padding-inline-start:18px;font-size:.84rem;color:var(--ink-soft)}
.never li{margin-bottom:5px}

fieldset{border:1px solid var(--rule);border-radius:4px;padding:14px 16px;margin:0 0 14px}
legend{font-size:.78rem;color:var(--ink-soft);padding:0 6px}
label.f{display:block;font-size:.86rem;color:var(--ink-soft);margin-bottom:4px}
input[type=text],select{width:100%;padding:9px 11px;border:1px solid var(--rule);border-radius:4px;background:var(--paper);font:inherit;font-size:.94rem;margin-bottom:12px;color:var(--ink)}
fieldset[disabled]{opacity:.55}
footer{border-top:1px solid var(--rule);padding:22px 0 60px;font-size:.85rem;color:var(--ink-soft)}
@media(max-width:900px){.layout{grid-template-columns:1fr}.ledger{position:static}.row{grid-template-columns:1fr;gap:4px}}
</style>
</head>
<body>

<div class="util"><div class="wrap">
  <div class="brand" id="brand"></div>
  <button data-scale="1" aria-pressed="true">ก</button>
  <button data-scale="1.14" aria-pressed="false">ก+</button>
  <button data-scale="1.3" aria-pressed="false">ก++</button>
  <button id="contrast" aria-pressed="false"></button>
  <button id="reset"></button>
  <button data-lang="th" aria-pressed="true">ไทย</button>
  <button data-lang="en" aria-pressed="false">EN</button>
</div></div>

<div class="wrap">
  <div class="rail" id="rail"></div>
  <div class="layout">
    <div>
      <section class="stage step on" id="s1">
        <div class="eyebrow" data-t="s1eye"></div><h2 class="big" data-t="s1h"></h2>
        <p class="note" data-t="s1note"></p>
        <div id="entryQs"></div>
        <div class="flag" id="pathFlag" style="display:none"></div>
        <div class="act"><button class="primary" id="toS2" disabled data-t="next"></button></div>
      </section>

      <section class="stage step" id="s2">
        <div class="eyebrow" data-t="s2eye"></div><h2 class="big" data-t="s2h"></h2>
        <p class="note" data-t="s2note"></p>
        <div id="litQs"></div>
        <div class="act">
          <button class="primary" id="toS3" disabled data-t="seeRec"></button>
          <button class="ghost" id="skipLit" data-t="skipLit"></button>
        </div>
      </section>

      <section class="stage step" id="s2b">
        <div class="eyebrow" data-t="fbEye"></div><h2 class="big" data-t="fbH"></h2>
        <div class="flag lock"><b data-t="fbFlagT"></b><span data-t="fbFlagS"></span></div>
        <div style="margin-top:20px" id="facForm"></div>
        <div class="act"><button class="primary" id="toS3b" data-t="fbBtn"></button></div>
      </section>

      <section class="stage step" id="s3">
        <div class="eyebrow" data-t="s3eye"></div><h2 class="big" data-t="s3h"></h2>
        <div id="rec"></div>
        <div class="act"><button class="primary" id="toS4" data-t="ok"></button>
        <button class="ghost" id="override" data-t="notRight"></button></div>
      </section>

      <section class="stage step" id="s4">
        <div class="eyebrow" data-t="s4eye"></div><h2 class="big" data-t="s4h"></h2>
        <p class="note" data-t="s4note"></p>
        <div id="profileForm"></div>
        <div class="act"><button class="primary" id="finish" data-t="save"></button>
        <button class="ghost" id="skipProf" data-t="skipProf"></button></div>
      </section>

      <section class="stage step" id="s5">
        <div class="eyebrow" data-t="s5eye"></div><h2 class="big" data-t="s5h"></h2>
        <div id="final"></div>
      </section>
    </div>

    <aside class="ledger" aria-labelledby="ledH">
      <header><b id="ledH" data-t="ledT"></b><span data-t="ledS"></span></header>
      <div class="body">
        <div id="ledger"></div>
        <div class="never"><b data-t="neverT"></b><ul id="neverList"></ul></div>
      </div>
    </aside>
  </div>
  <footer data-t="foot"></footer>
</div>

<script is:inline>
const D={
th:{
 brand:"AI Lines — ต้นแบบขั้นตอนสมัคร", contrast:"คอนทราสต์สูง", reset:"เริ่มใหม่", next:"ถัดไป",
 rail:[["เข้าใช้งาน","3 คำถาม ไม่ต้องสมัคร"],["จัดระดับ","แบบวัดเพื่อข้ามขั้น"],["คำแนะนำ","+ โปรไฟล์ (ไม่บังคับ)"],["สถานี 1","เริ่มเรียน"]],
 s1eye:"ช่วงที่ 1 จาก 3 · ไม่ต้องสมัคร ไม่ต้องใช้อีเมล", s1h:"สามคำถาม ก็รู้ว่าคุณอยู่สายไหน",
