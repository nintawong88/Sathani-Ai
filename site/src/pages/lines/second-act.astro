<!DOCTYPE html>
<html lang="th" data-contrast="normal">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>วัยเก๋า — สถานีการเรียน</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=IBM+Plex+Sans+Thai:wght@400;500;600&family=IBM+Plex+Mono:wght@400&display=swap" rel="stylesheet">
<style is:global>
:root{
  --paper:#EBEDF1;--card:#F7F8FA;--ink:#12161D;--ink-soft:#4E5765;--rule:#C7CDD6;
  --copper:#96471E;--lock:#8A2F2F;--ok:#237848;--scale:1.06;
  font-size:calc(16px * var(--scale));
}
html[data-contrast="high"]{--paper:#fff;--card:#fff;--ink:#000;--ink-soft:#1D2229;--rule:#7C838D;--copper:#6E2E09;--lock:#6B0000;--ok:#0C5730}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font-family:"IBM Plex Sans Thai",system-ui,sans-serif;line-height:1.7}
h1,h2,h3{font-weight:600;margin:0;line-height:1.32}
html[lang="en"] h1,html[lang="en"] h2{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;letter-spacing:-.02em;line-height:1.12}
button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.wrap{max-width:900px;margin:0 auto;padding:0 20px}
.eyebrow{font-size:.82rem;color:var(--ink-soft)}

.util{position:sticky;top:0;z-index:60;background:var(--ink);color:var(--paper)}
.util .wrap{display:flex;gap:9px;align-items:center;flex-wrap:wrap;padding:8px 20px;max-width:900px}
.util .brand{font-weight:600;margin-right:auto}
.util button{background:transparent;border:1px solid rgba(255,255,255,.3);color:inherit;border-radius:99px;padding:3px 11px;font-size:.8rem}
.util button[aria-pressed="true"]{background:var(--paper);color:var(--ink)}
.util :focus-visible{outline-color:#fff}

/* station rail */
.srail{display:flex;gap:8px;margin:28px 0 22px;flex-wrap:wrap}
.srail button{flex:1 1 150px;text-align:left;background:var(--card);border:1px solid var(--rule);border-radius:4px;padding:10px 13px;position:relative}
.srail button[aria-current="true"]{border-color:var(--copper);border-width:2px;background:var(--paper)}
.srail .num{font-family:"IBM Plex Mono",monospace;font-size:.72rem;color:var(--ink-soft);display:block}
.srail .nm{font-weight:600;font-size:.94rem;display:block;line-height:1.35}
.srail .st{font-size:.74rem;display:inline-block;margin-top:5px;border-radius:99px;padding:0 9px;border:1px solid var(--rule);color:var(--ink-soft)}
.srail .st.req{border-color:var(--lock);color:var(--lock)}
.srail .st.done{border-color:var(--ok);color:var(--ok)}

.head{border-top:6px solid var(--copper);background:var(--card);border:1px solid var(--rule);border-top-width:6px;border-radius:4px;padding:24px}
.head h1{font-size:clamp(1.6rem,4.4vw,2.3rem)}
.meta{display:flex;gap:22px;flex-wrap:wrap;margin-top:16px;padding-top:14px;border-top:1px solid var(--rule)}
.meta div span{display:block;font-size:.76rem;color:var(--ink-soft)}
.meta div b{font-weight:600}

.req{border-left:5px solid var(--lock);background:var(--paper);padding:13px 16px;margin-top:18px;border-radius:0 4px 4px 0}
.req b{display:block;color:var(--lock)}
.req span{font-size:.9rem;color:var(--ink-soft)}

/* steps */
.step{background:var(--card);border:1px solid var(--rule);border-radius:4px;padding:22px;margin-top:16px}
.step>header{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.badge{width:38px;height:38px;border-radius:50%;border:3px solid var(--copper);color:var(--copper);display:grid;place-items:center;font-weight:600;flex:0 0 auto;background:var(--paper)}
.step h2{font-size:1.28rem}
.step .mins{margin-inline-start:auto;font-size:.8rem;color:var(--ink-soft);white-space:nowrap}
.video{border:1px dashed var(--rule);border-radius:4px;padding:16px;display:flex;gap:14px;align-items:center;background:var(--paper)}
.video .play{width:44px;height:44px;border-radius:50%;background:var(--ink);color:var(--paper);display:grid;place-items:center;flex:0 0 auto}
.video b{display:block}
.video span{font-size:.84rem;color:var(--ink-soft)}

.prompt{border:2px solid var(--ink);border-radius:4px;background:var(--paper);margin-top:12px}
.prompt .ptxt{padding:16px 18px;font-size:1.06rem}
.prompt footer{display:flex;gap:10px;align-items:center;border-top:1px solid var(--rule);padding:9px 14px;flex-wrap:wrap}
.prompt footer span{font-size:.8rem;color:var(--ink-soft);margin-inline-end:auto}
.copy{background:var(--ink);color:var(--paper);border:0;border-radius:99px;padding:6px 16px;font-size:.86rem}
.expect{margin-top:12px;font-size:.92rem;color:var(--ink-soft)}
.stuck{margin-top:12px;border-inline-start:4px solid var(--rule);padding-inline-start:14px;font-size:.9rem;color:var(--ink-soft)}
.stuck b{color:var(--ink);font-weight:600}

.donebox{display:flex;gap:12px;align-items:flex-start;margin-top:16px;border-top:1px solid var(--rule);padding-top:14px}
.check{width:30px;height:30px;border:2px solid var(--rule);border-radius:6px;background:var(--paper);flex:0 0 auto;display:grid;place-items:center;font-size:1rem;color:transparent}
.check[aria-pressed="true"]{border-color:var(--ok);color:var(--ok)}
.donebox p{margin:0;font-size:.94rem}
.donebox p b{display:block}

.foot{margin:26px 0 70px;display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.primary{background:var(--ink);color:var(--paper);border:0;border-radius:99px;padding:11px 24px}
.ghost{background:transparent;border:1px solid var(--rule);border-radius:99px;padding:11px 20px}
.pausenote{width:100%;font-size:.9rem;color:var(--ink-soft);margin-top:4px}
.printonly{display:none}

@media print{
  .util,.srail,.foot,.copy,.donebox,.video .play{display:none!important}
  body{background:#fff;font-size:13pt}
  .step,.head{border:1px solid #999;break-inside:avoid;background:#fff}
  .printonly{display:block;font-size:.9rem;color:#444;margin-bottom:10px}
  .prompt{border-color:#000}
  a[href]::after{content:""}
}
@media(max-width:600px){.meta{gap:14px}.step{padding:18px}}
</style>
</head>
<body>

<div class="util"><div class="wrap">
  <a href="/" style="background:transparent;border:1px solid rgba(255,255,255,.3);color:inherit;border-radius:99px;padding:3px 11px;font-size:.8rem;text-decoration:none">← สถานี AI</a>
  <div class="brand" id="brand"></div>
  <button data-scale="1.06" aria-pressed="true">ก</button>
  <button data-scale="1.2" aria-pressed="false">ก+</button>
  <button data-scale="1.38" aria-pressed="false">ก++</button>
  <button id="contrast" aria-pressed="false"></button>
  <button id="print"></button>
  <button data-lang="th" aria-pressed="true">ไทย</button>
  <button data-lang="en" aria-pressed="false">EN</button>
</div></div>

<div class="wrap">
  <nav class="srail" id="srail" aria-label="stations"></nav>
  <div id="station"></div>
</div>

