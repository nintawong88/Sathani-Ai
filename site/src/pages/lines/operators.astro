<!DOCTYPE html>
<html lang="th" data-contrast="normal">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>คนทำงาน — สถานีการเรียน</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=IBM+Plex+Sans+Thai:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style is:global>
:root{
  --paper:#EBEDF1;--card:#F7F8FA;--ink:#12161D;--ink-soft:#4E5765;--rule:#C7CDD6;
  --teal:#0C6D7C;--lock:#8A2F2F;--ok:#237848;--scale:1;
  font-size:calc(16px * var(--scale));
}
html[data-contrast="high"]{--paper:#fff;--card:#fff;--ink:#000;--ink-soft:#1D2229;--rule:#7C838D;--teal:#004C59;--lock:#6B0000;--ok:#0C5730}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font-family:"IBM Plex Sans Thai",system-ui,sans-serif;line-height:1.65}
h1,h2,h3{font-weight:600;margin:0;line-height:1.32}
html[lang="en"] h1,html[lang="en"] h2{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;letter-spacing:-.02em;line-height:1.14}
button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.wrap{max-width:940px;margin:0 auto;padding:0 20px}
.eyebrow{font-size:.82rem;color:var(--ink-soft)}
.mono{font-family:"IBM Plex Mono",monospace}

.util{position:sticky;top:0;z-index:60;background:var(--ink);color:var(--paper)}
.util .wrap{display:flex;gap:9px;align-items:center;flex-wrap:wrap;padding:8px 20px;max-width:940px}
.util .brand{font-weight:600;margin-right:auto}
.util button{background:transparent;border:1px solid rgba(255,255,255,.3);color:inherit;border-radius:99px;padding:3px 11px;font-size:.8rem}
.util button[aria-pressed="true"]{background:var(--paper);color:var(--ink)}
.util :focus-visible{outline-color:#fff}

.srail{display:flex;gap:8px;margin:28px 0 22px;flex-wrap:wrap}
.srail button{flex:1 1 165px;text-align:left;background:var(--card);border:1px solid var(--rule);border-radius:4px;padding:10px 13px}
.srail button[aria-current="true"]{border-color:var(--teal);border-width:2px;background:var(--paper)}
.srail .num{font-family:"IBM Plex Mono",monospace;font-size:.72rem;color:var(--ink-soft);display:block}
.srail .nm{font-weight:600;font-size:.93rem;display:block;line-height:1.35}
.srail .st{font-size:.73rem;display:inline-block;margin-top:5px;border-radius:99px;padding:0 9px;border:1px solid var(--rule);color:var(--ink-soft)}
.srail .st.gate{border-color:var(--lock);color:var(--lock)}
.srail .st.done{border-color:var(--ok);color:var(--ok)}

.head{background:var(--card);border:1px solid var(--rule);border-top:6px solid var(--teal);border-radius:4px;padding:24px}
.head h1{font-size:clamp(1.5rem,4.2vw,2.2rem)}
.meta{display:flex;gap:24px;flex-wrap:wrap;margin-top:16px;padding-top:14px;border-top:1px solid var(--rule)}
.meta div span{display:block;font-size:.76rem;color:var(--ink-soft)}
.meta div b{font-weight:600}

.gate{border:2px solid var(--lock);border-radius:4px;padding:18px;margin-top:18px;background:var(--paper)}
.gate h3{color:var(--lock);font-size:1.05rem}
.gate p{font-size:.9rem;color:var(--ink-soft);margin:6px 0 12px}
.gitem{display:flex;gap:11px;align-items:flex-start;padding:8px 0;border-top:1px dashed var(--rule)}
.gitem:first-of-type{border-top:0}
.gitem p{margin:0;font-size:.94rem;color:var(--ink)}
.veil{position:relative}
.veil.locked>.step{filter:blur(3px);opacity:.4;pointer-events:none;user-select:none}
.veilmsg{text-align:center;padding:22px;border:1px dashed var(--lock);border-radius:4px;margin-top:16px;color:var(--lock);font-size:.95rem}

.step{background:var(--card);border:1px solid var(--rule);border-radius:4px;padding:22px;margin-top:16px}
.step>header{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.badge{width:36px;height:36px;border-radius:50%;border:3px solid var(--teal);color:var(--teal);display:grid;place-items:center;font-weight:600;flex:0 0 auto;background:var(--paper)}
.step h2{font-size:1.24rem}
.step .mins{margin-inline-start:auto;font-size:.8rem;color:var(--ink-soft);white-space:nowrap}
.video{border:1px dashed var(--rule);border-radius:4px;padding:15px;display:flex;gap:14px;align-items:center;background:var(--paper)}
.video .play{width:40px;height:40px;border-radius:50%;background:var(--ink);color:var(--paper);display:grid;place-items:center;flex:0 0 auto}
.video b{display:block}
.video span{font-size:.83rem;color:var(--ink-soft)}

.prompt{border:2px solid var(--ink);border-radius:4px;background:var(--paper);margin-top:12px}
.prompt .ptxt{padding:15px 17px;font-size:1rem}
.prompt footer{display:flex;gap:10px;align-items:center;border-top:1px solid var(--rule);padding:8px 13px;flex-wrap:wrap}
.prompt footer span{font-size:.79rem;color:var(--ink-soft);margin-inline-end:auto}
.copy{background:var(--ink);color:var(--paper);border:0;border-radius:99px;padding:6px 16px;font-size:.85rem}
.noai{border:1px solid var(--rule);border-radius:4px;background:var(--paper);padding:15px 17px;margin-top:12px}
.noai b{display:block;color:var(--teal)}
.noai ul{margin:8px 0 0;padding-inline-start:18px;font-size:.93rem}
.noai li{margin-bottom:5px}
.expect{margin-top:12px;font-size:.92rem;color:var(--ink-soft)}
.stuck{margin-top:12px;border-inline-start:4px solid var(--rule);padding-inline-start:14px;font-size:.9rem;color:var(--ink-soft)}
.stuck b{color:var(--ink);font-weight:600}

.calc{border:2px solid var(--teal);border-radius:4px;padding:18px;margin-top:14px;background:var(--paper)}
.calc h3{color:var(--teal);font-size:1.02rem;margin-bottom:4px}
.calc p.sub{font-size:.86rem;color:var(--ink-soft);margin:0 0 12px}
.cfields{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.cfields label{font-size:.8rem;color:var(--ink-soft);display:block;margin-bottom:3px}
.cfields input{width:100%;padding:9px 10px;border:1px solid var(--rule);border-radius:4px;background:var(--card);font:inherit;color:var(--ink)}
.cout{margin-top:14px;padding-top:12px;border-top:1px solid var(--rule);display:flex;gap:26px;flex-wrap:wrap}
.cout div b{display:block;font-family:"IBM Plex Mono",monospace;font-size:1.5rem;font-weight:500}
.cout div span{font-size:.76rem;color:var(--ink-soft)}
.cwarn{font-size:.84rem;color:var(--lock);margin-top:10px}

.donebox{display:flex;gap:12px;align-items:flex-start;margin-top:16px;border-top:1px solid var(--rule);padding-top:14px}
.check{width:28px;height:28px;border:2px solid var(--rule);border-radius:6px;background:var(--paper);flex:0 0 auto;display:grid;place-items:center;color:transparent}
.check[aria-pressed="true"]{border-color:var(--ok);color:var(--ok)}
.donebox p{margin:0;font-size:.93rem}
.donebox p b{display:block}

.foot{margin:26px 0 70px;display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.primary{background:var(--ink);color:var(--paper);border:0;border-radius:99px;padding:11px 24px}
.ghost{background:transparent;border:1px solid var(--rule);border-radius:99px;padding:11px 20px}
.pausenote{width:100%;font-size:.88rem;color:var(--ink-soft);margin-top:4px}
@media print{.util,.srail,.foot,.copy,.donebox,.video .play{display:none!important}body{background:#fff;font-size:12pt}.step,.head,.calc{border:1px solid #999;break-inside:avoid;background:#fff}.veil.locked>.step{filter:none;opacity:1}}
@media(max-width:640px){.cfields{grid-template-columns:1fr}.step{padding:18px}}
</style>
</head>
<body>

<div class="util"><div class="wrap">
  <div class="brand" id="brand"></div>
  <button data-scale="1" aria-pressed="true">ก</button>
  <button data-scale="1.14" aria-pressed="false">ก+</button>
  <button data-scale="1.3" aria-pressed="false">ก++</button>
  <button id="contrast" aria-pressed="false"></button>
  <button id="print"></button>
  <button data-lang="th" aria-pressed="true">ไทย</button>
  <button data-lang="en" aria-pressed="false">EN</button>
</div></div>

<div class="wrap">
  <nav class="srail" id="srail" aria-label="stations"></nav>
  <div id="station"></div>
</div>

